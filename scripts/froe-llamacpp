#!/usr/bin/env bash
# froe-llamacpp: start llama.cpp's llama-server the way froe needs it.
#
# The flags that matter live here instead of in someone's memory:
#   --jinja       - the model's own chat template, which native tool calls need.
#   --parallel 1  - one slot holds the conversation, so every turn that extends
#                   it reads only what is new (froe's prefix_reuse). Several
#                   slots split the window and can send a turn to a cold slot.
#   -c 32768      - the window froe budgets for. --fit (on by default) sizes the
#                   GPU/CPU split to the card for that window; on an 8 GB card a
#                   30B mixture-of-experts model keeps most experts on the CPU.
#                   Measured 2026-11-06: 8K to 64K cost no generation speed
#                   there, because --fit moves a few more experts to the CPU.
#
# Usage: froe-llamacpp --model FILE.gguf [--model-id ID] [--port N] [--ctx N]
#                      [--background] [--dry-run] [-- EXTRA llama-server ARGS]
#
# --background: for an editor's launch key (Neovim's <leader>dl) and for froe
# itself, which runs it when the runtime is down. If llama-server already
# serves the model on the port, say so and exit 0. Otherwise start it detached,
# logging to $FROE_LLAMACPP_LOG (~/.cache/froe/llamacpp.log), and exit 0 once
# it answers - or 1, with the log's tail, if it dies or takes longer than
# $FROE_LLAMACPP_WAIT seconds (300). Without it, llama-server runs in the
# foreground.
#
# Defaults come from the environment where set: LLAMA_SERVER (path to
# llama-server), FROE_LLAMACPP_MODEL, FROE_LLAMACPP_MODEL_ID, FROE_LLAMACPP_PORT.
set -euo pipefail

usage() {
  sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

model="${FROE_LLAMACPP_MODEL:-}"
model_id="${FROE_LLAMACPP_MODEL_ID:-qwen3-coder-30b}"   # froe's registry runtime_id
port="${FROE_LLAMACPP_PORT:-8080}"                      # llama-server's own default
ctx=32768
dry=0
background=0
extra=()

while [ $# -gt 0 ]; do
  case "$1" in
    --model)      model="$2"; shift 2 ;;
    --model-id)   model_id="$2"; shift 2 ;;
    --port)       port="$2"; shift 2 ;;
    --ctx)        ctx="$2"; shift 2 ;;
    --background) background=1; shift ;;
    --dry-run)    dry=1; shift ;;
    -h|--help)    usage 0 ;;
    --)           shift; extra=("$@"); break ;;
    *) echo "froe-llamacpp: unknown argument: $1" >&2; usage 2 ;;
  esac
done

[ -n "$model" ] || { echo "froe-llamacpp: --model FILE.gguf is required" >&2; exit 2; }
[ "$dry" = 1 ] || [ -f "$model" ] || { echo "froe-llamacpp: no such model file: $model" >&2; exit 2; }

# llama-server: $LLAMA_SERVER, then PATH, then a build in the usual place.
server="${LLAMA_SERVER:-}"
if [ -z "$server" ]; then
  if command -v llama-server >/dev/null 2>&1; then server="$(command -v llama-server)"
  elif [ -x "$HOME/src/llama.cpp/build/bin/llama-server" ]; then server="$HOME/src/llama.cpp/build/bin/llama-server"
  fi
fi
[ -n "$server" ] || { echo "froe-llamacpp: llama-server not found - set LLAMA_SERVER=/path/to/llama-server or put it on PATH" >&2; exit 2; }

cmd=("$server" -m "$model" --alias "$model_id" --jinja -c "$ctx" --parallel 1
     --host 127.0.0.1 --port "$port" ${extra[@]+"${extra[@]}"})

echo "froe-llamacpp: model id $model_id, http://127.0.0.1:$port/v1" >&2
if [ "$port" != 8080 ]; then
  echo "froe-llamacpp: not the default port - set base_url = \"http://127.0.0.1:$port/v1\" under [runtime.llamacpp] in ~/.config/froe/runtimes.toml" >&2
fi

if [ "$dry" = 1 ]; then
  printf '%s ' "${cmd[@]}"
  echo
  exit 0
fi
[ "$background" = 1 ] || exec "${cmd[@]}"

# --background from here on.
models="http://127.0.0.1:$port/v1/models"
# What answers on the port now: 000 is nothing listening.
code=$(curl -s -m 3 -o /dev/null -w '%{http_code}' "$models" || true)
if [ "$code" = 200 ]; then
  if curl -s -m 3 "$models" | grep -q "\"id\": *\"$model_id\""; then
    echo "froe-llamacpp: already serving $model_id on port $port" >&2
    exit 0
  fi
  echo "froe-llamacpp: port $port already serves another model - stop that llama-server first" >&2
  exit 1
elif [ "$code" != 000 ]; then
  echo "froe-llamacpp: port $port is taken by something that is not llama-server (HTTP $code) - pick another with --port" >&2
  exit 1
fi

log="${FROE_LLAMACPP_LOG:-$HOME/.cache/froe/llamacpp.log}"
mkdir -p "$(dirname "$log")"
setsid "${cmd[@]}" > "$log" 2>&1 < /dev/null &
pid=$!
wait_s="${FROE_LLAMACPP_WAIT:-300}"
echo "froe-llamacpp: starting (pid $pid, log $log), waiting up to ${wait_s}s" >&2
for _ in $(seq 1 "$wait_s"); do
  if curl -s -m 2 "$models" | grep -q "\"id\": *\"$model_id\""; then
    echo "froe-llamacpp: ready, serving $model_id on port $port" >&2
    exit 0
  fi
  if ! kill -0 "$pid" 2>/dev/null; then
    echo "froe-llamacpp: llama-server exited before it was ready; the end of $log:" >&2
    tail -n 15 "$log" >&2
    exit 1
  fi
  sleep 1
done
echo "froe-llamacpp: not ready after ${wait_s}s; still loading? the end of $log:" >&2
tail -n 15 "$log" >&2
exit 1
